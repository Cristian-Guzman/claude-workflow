{
  "env": {
    "WORKFLOW_LAYOUT": "workspace"
  },
  "permissions": {
    "allow": [
      "Bash(ssh:*)",
      "Bash(npx eslint:*)",
      "Bash(jira me:*)",
      "Bash(jira issue:*)",
      "Bash(git add:*)",
      "Bash(yarn lint:*)",
      "Bash(jira sprint:*)",
      "Bash(jira board:*)",
      "Read(~/.config/.jira/**)",
      "Bash(pkill -f \"yarn local\")",
      "Bash(pkill -f \"yarn dev\")",
      "Bash(pkill -f \"next dev\")",
      "Bash(pkill -f \"ts-node\")",
      "Bash(pkill -f \"nodemon\")",
      "Bash(git diff:*)",
      "WebFetch(domain:localhost)",
      "Read(//private/tmp/**)",
      "Read(//tmp/**)",
      "Bash(gh pr:*)",
      "Bash(gh run:*)",
      "Bash(npm run:*)",
      "Bash(yarn ci *)",
      "Bash(echo \"CI EXIT=$?\")",
      "Bash(mkdir -p *)",
      "Bash(gh run *)",
      "Bash(jira version *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/scripts/guard-base-branch.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/scripts/guard-base-branch.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "path=$(jq -r '.tool_input.file_path // empty'); [[ \"$path\" =~ /\\.claude/(tickets|debug|builds|refactors|e2e)/[^/]+\\.md$ ]] && \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/state-index-upsert.sh \"$path\" || true",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  }
}
