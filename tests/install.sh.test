#!/usr/bin/env bash
# tests/install.sh.test — scratch-dir suite for install.sh (roles, manifests, capture, seeds).
#
# Usage:  bash tests/install.sh.test            (from the repo root or anywhere)
#         KEEP=1 bash tests/install.sh.test     keep the scratch dir for inspection
#
# Every case installs into a fresh directory under $TMPDIR and prints PASS/FAIL.
# Expectations are computed from the repo tree (core/ + roles/<r>/), so the suite
# stays valid as roles gain or lose files. Exit code is non-zero on any FAIL.
set -uo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
S="$(mktemp -d "${TMPDIR:-/tmp}/install-sh-test.XXXXXX")"
INSTALL="$REPO/install.sh"
TODAY="$(date -u +%Y-%m-%d)"
pass=0; fail=0; case_fail=0

cleanup() { [ "${KEEP:-0}" = 1 ] && echo "scratch kept at $S" || rm -rf "$S"; }
trap cleanup EXIT

# ---------------------------------------------------------------- harness
begin() { case_fail=0; CASE="$1"; }
end()   { if [ "$case_fail" = 0 ]; then echo "PASS  $CASE"; pass=$((pass + 1)); else echo "FAIL  $CASE"; fail=$((fail + 1)); fi; }
ok()    { :; }
bad()   { echo "    x $*"; case_fail=1; }
assert()        { local msg="$1"; shift; if "$@" >/dev/null 2>&1; then ok; else bad "$msg"; fi; }
assert_not()    { local msg="$1"; shift; if "$@" >/dev/null 2>&1; then bad "$msg"; else ok; fi; }
assert_eq()     { [ "$2" = "$3" ] && ok || bad "$1: expected [$3] got [$2]"; }
assert_grep()   { grep -q -- "$2" "$3" 2>/dev/null && ok || bad "$1: '$2' not found in $(basename "$3")"; }
assert_nogrep() { grep -q -- "$2" "$3" 2>/dev/null && bad "$1: '$2' unexpectedly found in $(basename "$3")" || ok; }
fresh()  { local d="$S/$1"; rm -rf "$d"; mkdir -p "$d"; echo "$d"; }
run()    { "$INSTALL" "$@" >"$S/out.log" 2>"$S/err.log"; echo $? >"$S/rc"; }
rc()     { cat "$S/rc"; }

expected_cmds() { # $@ = roles -> sorted basenames core/commands + roles/<r>/commands
  { ls "$REPO"/core/commands/*.md; for r in "$@"; do ls "$REPO/roles/$r"/commands/*.md 2>/dev/null; done; } \
    | xargs -n1 basename | sort -u
}
installed_cmds() { ls "$1/.claude/commands"/*.md 2>/dev/null | xargs -n1 basename | sort; }
manifest_roles() { sed -n 's/.*"roles": *\[\([^]]*\)\].*/\1/p' "$1/.claude/workflow-manifest.json" | tr -d '" '; }
seed_sha() { # project-owned files that must never change on re-run
  (cd "$1" && shasum -a 256 .claude/settings.json .claude/codebase-patterns.md .claude/testing-patterns.md \
      .claude/ticket-checklist.md .claude/pr-template.md CLAUDE.md .claude/upstream.json \
      .claude/repo-profiles/_schema.yaml 2>/dev/null)
}
seeds_unchanged() { # $1 = workspace, $2 = earlier seed_sha output; re-hash only the files listed there
  (cd "$1" && awk '{print $NF}' "$2" | xargs shasum -a 256) | diff "$2" -
}
copy_repo() { # editable copy of the checkout (working tree, not HEAD) without .git
  local d="$S/$1"; rm -rf "$d"; mkdir -p "$d"
  (cd "$REPO" && tar --exclude=.git --exclude=./tests -cf - .) | (cd "$d" && tar -xf -)
  echo "$d"
}
DEV_ROLE_CMDS="$(ls "$REPO"/roles/dev/commands/*.md | xargs -n1 basename)"
CORE_DOCS="$(ls "$REPO"/core/docs/*.md "$REPO"/core/docs/*.yaml 2>/dev/null | xargs -n1 basename)"

echo "install.sh suite — scratch $S"
echo ""

# ---------------------------------------------------------------- 1. fresh dev
begin "1  fresh --role dev"
W="$(fresh c1)"; run "$W" --role dev
assert_eq "exit" "$(rc)" 0
assert_eq "commands = core + dev" "$(installed_cmds "$W")" "$(expected_cmds dev)"
assert_eq "manifest roles" "$(manifest_roles "$W")" "dev"
assert_grep "upstream manifest carries roles" '"roles": \["dev"\]' "$W/.claude/.upstream-manifest.json"
assert "baseline mirrors commands" diff -r "$W/.claude/.upstream-base/commands" "$W/.claude/commands"
assert "baseline mirrors agents" diff -r "$W/.claude/.upstream-base/agents" "$W/.claude/agents"
assert "baseline mirrors scripts" diff -r "$W/.claude/.upstream-base/scripts" "$W/.claude/scripts"
for d in $CORE_DOCS; do assert "doc $d at .claude root" test -f "$W/.claude/$d"; assert "doc $d in baseline" cmp -s "$W/.claude/$d" "$W/.claude/.upstream-base/docs/$d"; done
assert "learn-targets/dev.yaml installed" cmp -s "$REPO/roles/dev/learn-targets.yaml" "$W/.claude/learn-targets/dev.yaml"
assert "no prior capture on a fresh install" test ! -e "$W/.claude/.upstream-prior"
assert "no archive on a fresh install" test ! -e "$W/.claude/_archived-commands"
assert_grep "Done line prints roles" "Done. roles: dev |" "$S/out.log"
assert_grep "checklist names dev start-here" "/ticket (or /build without a tracker) -> /pr-creation -> /learn" "$S/out.log"
assert_grep "checklist names sdet start-here" "/cover -> /pr-creation -> /learn" "$S/out.log"
assert_grep "checklist names cold start" "mine-history.sh" "$S/out.log"
assert_grep "checklist names --role" "\-\-role" "$S/out.log"
assert_grep "gitignore has manifest-free local state" "^.claude/.upstream-prior/$" "$W/.gitignore"
assert_nogrep "workflow-manifest.json is tracked (not ignored)" "workflow-manifest.json" "$W/.gitignore"
assert "drift clean" sh -c "python3 '$REPO/core/scripts/upstream.py' --root '$W/.claude' drift | grep -q 'no local edits'"
end

# ---------------------------------------------------------------- 2. fresh sdet
begin "2  fresh --role sdet"
W="$(fresh c2)"; run "$W" --role sdet
assert_eq "exit" "$(rc)" 0
assert_eq "commands = core + sdet" "$(installed_cmds "$W")" "$(expected_cmds sdet)"
for c in $DEV_ROLE_CMDS; do assert "dev command $c absent" test ! -f "$W/.claude/commands/$c"; done
assert_eq "agents = core agents" "$(ls "$W/.claude/agents" | wc -l | tr -d ' ')" "$(ls "$REPO"/core/agents/*.md | wc -l | tr -d ' ')"
assert_eq "manifest roles" "$(manifest_roles "$W")" "sdet"
assert "no dev learn-targets" test ! -e "$W/.claude/learn-targets/dev.yaml"
assert "baseline mirrors commands" diff -r "$W/.claude/.upstream-base/commands" "$W/.claude/commands"
end

# ---------------------------------------------------------------- 3. combine, three spellings
begin "3  combine dev+sdet (three spellings)"
A="$(fresh c3a)"; run "$A" --role dev --role sdet; assert_eq "exit a" "$(rc)" 0
B="$(fresh c3b)"; run "$B" --roles dev,sdet;      assert_eq "exit b" "$(rc)" 0
C="$(fresh c3c)"; run --roles=sdet,dev "$C";      assert_eq "exit c (flags before target)" "$(rc)" 0
assert_eq "commands = core + dev + sdet" "$(installed_cmds "$A")" "$(expected_cmds dev sdet)"
assert_eq "manifest a" "$(manifest_roles "$A")" "dev,sdet"
assert_eq "manifest c (sorted)" "$(manifest_roles "$C")" "dev,sdet"
assert "a == b" diff -r -x .upstream-manifest.json "$A" "$B"
assert "a == c" diff -r -x .upstream-manifest.json "$A" "$C"
end

# ---------------------------------------------------------------- 4. idempotency with edited seeds
begin "4  re-run keeps edited seeds; touches only upstream-owned paths"
W="$(fresh c4)"; run "$W" --role dev
echo "## Local pattern" >>"$W/.claude/codebase-patterns.md"
echo "## Local testing note" >>"$W/.claude/testing-patterns.md"
echo "Local CLAUDE.md edit" >>"$W/CLAUDE.md"
jq '.env.LOCAL_EDIT = "1"' "$W/.claude/settings.json" >"$S/tmp.json" && mv "$S/tmp.json" "$W/.claude/settings.json"
seed_sha "$W" >"$S/before"
touch "$S/marker"; sleep 1
run "$W"
assert_eq "exit" "$(rc)" 0
assert_eq "roles from manifest" "$(manifest_roles "$W")" "dev"
assert_grep "role source is the manifest" "roles    dev (.claude/workflow-manifest.json)" "$S/out.log"
seed_sha "$W" >"$S/after"
assert "seed hashes unchanged" diff "$S/before" "$S/after"
assert_grep "local settings edit survived" "LOCAL_EDIT" "$W/.claude/settings.json"
newer="$(cd "$W" && find .claude CLAUDE.md .gitignore -newer "$S/marker" -type f | sort)"
bad_paths=""
while IFS= read -r p; do
  [ -n "$p" ] || continue
  case "$p" in
    .claude/commands/*|.claude/agents/*|.claude/scripts/*|.claude/learn-targets/*|.claude/.upstream-base/*|.claude/.upstream-manifest.json|.claude/workflow-manifest.json) ;;
    *) b="$(basename "$p")"; echo "$CORE_DOCS" | grep -qx "$b" && [ "$p" = ".claude/$b" ] || bad_paths="$bad_paths $p" ;;
  esac
done <<EOF
$newer
EOF
assert_eq "only upstream-owned paths rewritten" "$bad_paths" ""
assert "something was refreshed" test -n "$newer"
assert "no drift capture when the core was not edited" test ! -e "$W/.claude/.upstream-prior"
assert_grep "clean core reported in one line" "core matches the baseline — nothing to capture" "$S/out.log"
end

# ---------------------------------------------------------------- 5. switch roles and back
begin "5  switch dev -> sdet -> dev archives, never deletes"
W="$(fresh c5)"; run "$W" --role dev
echo "## Local pattern" >>"$W/.claude/codebase-patterns.md"
seed_sha "$W" >"$S/before"
run "$W" --role sdet
assert_eq "exit" "$(rc)" 0
assert_eq "manifest roles" "$(manifest_roles "$W")" "sdet"
assert_eq "commands = core + sdet" "$(installed_cmds "$W")" "$(expected_cmds sdet)"
for c in $DEV_ROLE_CMDS; do assert "$c archived" test -f "$W/.claude/_archived-commands/$c"; done
assert "dev learn-targets archived" test -f "$W/.claude/_archived-commands/learn-targets/dev.yaml"
assert "dev learn-targets removed from live dir" test ! -e "$W/.claude/learn-targets/dev.yaml"
seed_sha "$W" >"$S/after"; assert "seeds untouched by the switch" diff "$S/before" "$S/after"
assert_grep "archive is reported" "archived commands/verify.md" "$S/out.log"
run "$W" --role dev
assert_eq "exit back" "$(rc)" 0
assert_eq "manifest back to dev" "$(manifest_roles "$W")" "dev"
assert_eq "commands = core + dev again" "$(installed_cmds "$W")" "$(expected_cmds dev)"
for c in $DEV_ROLE_CMDS; do assert "archive of $c still present" test -f "$W/.claude/_archived-commands/$c"; done
assert "no archive-dir entries deleted" test "$(ls "$W/.claude/_archived-commands" | wc -l)" -ge "$(echo "$DEV_ROLE_CMDS" | wc -l)"
run "$W" --role sdet; run "$W" --role dev; run "$W" --role sdet
assert "second archive of the same file gets a timestamp suffix" sh -c "ls '$W/.claude/_archived-commands' | grep -q '^verify\.md\.[0-9]\{8\}T[0-9]\{6\}Z$'"
end

# ---------------------------------------------------------------- 6. --repo-only per role
begin "6  --repo-only seeds only; role from flag, then from the workspace manifest"
W="$(fresh c6)"; run "$W" --role dev
mkdir -p "$W/repo-a" "$W/repo-b"
run "$W/repo-a" --repo-only --role sdet
assert_eq "exit" "$(rc)" 0
assert_grep "role from flag" "roles    sdet (--role)" "$S/out.log"
assert "seeds present" test -f "$W/repo-a/.claude/codebase-patterns.md"
assert "CLAUDE.md seeded" test -f "$W/repo-a/CLAUDE.md"
assert "no manifest in repo" test ! -e "$W/repo-a/.claude/workflow-manifest.json"
assert "no baseline in repo" test ! -e "$W/repo-a/.claude/.upstream-base"
assert "no commands in repo" test ! -e "$W/repo-a/.claude/commands"
assert "no settings.json in repo" test ! -e "$W/repo-a/.claude/settings.json"
assert_grep "gitignore block" "claude-workflow local state" "$W/repo-a/.gitignore"
assert_nogrep "no checklist in repo-only" "Next steps to specialize" "$S/out.log"
run "$W/repo-b" --repo-only
assert_grep "role inherited from workspace manifest" "roles    dev (workspace manifest)" "$S/out.log"
touch "$S/marker6"; sleep 1
run "$W/repo-a" --repo-only --role sdet
assert_eq "re-run writes nothing" "$(find "$W/repo-a" -newer "$S/marker6" -type f | wc -l | tr -d ' ')" "0"
L="$(fresh c6-lone)"; run "$L" --repo-only
assert_grep "no workspace -> dev default" "roles    dev (default)" "$S/out.log"
end

# ---------------------------------------------------------------- 7. legacy upgrades
begin "7  legacy upgrade from a 0.6.0 install (no baseline) and from a 0.7.0 install (baseline)"
# 0.6.0 = the parent of the commit that introduced the upstream baseline in install.sh
V6="$(git -C "$REPO" log --format=%h -S write_upstream_baseline -- install.sh | tail -1)"
if [ -n "$V6" ] && git -C "$REPO" rev-parse --verify -q "$V6^" >/dev/null; then
  LEG="$S/legacy-060"; mkdir -p "$LEG"; git -C "$REPO" archive "$V6^" | tar -x -C "$LEG"
  W="$(fresh c7)"
  bash "$LEG/install.sh" "$W" >/dev/null 2>&1
  assert "0.6.0 install has test-plan.md" test -f "$W/.claude/commands/test-plan.md"
  assert "0.6.0 install has no manifest" test ! -e "$W/.claude/workflow-manifest.json"
  assert "0.6.0 install has no baseline" test ! -e "$W/.claude/.upstream-base"
  echo "## Local pattern" >>"$W/.claude/codebase-patterns.md"
  echo "<!-- local edit -->" >>"$W/.claude/commands/verify.md"
  seed_sha "$W" >"$S/before"
  run "$W"
  assert_eq "exit" "$(rc)" 0
  assert_grep "roles inferred" "roles    dev (inferred from installed commands)" "$S/out.log"
  assert_eq "manifest written as dev" "$(manifest_roles "$W")" "dev"
  assert_eq "commands = core + dev (+ the orphans 0.6.0 left: retired test-plan.md, renamed pr.md)" "$(installed_cmds "$W" | grep -vxE 'test-plan.md|pr.md')" "$(expected_cmds dev)"
  assert "orphan kept: no baseline proves test-plan.md was upstream's" test -f "$W/.claude/commands/test-plan.md"
  assert "nothing archived" test ! -e "$W/.claude/_archived-commands"
  assert "baseline created" test -d "$W/.claude/.upstream-base/commands"
  assert "seeds untouched" seeds_unchanged "$W" "$S/before"
  assert "0.6.0 had no upstream.json; now seeded" test -f "$W/.claude/upstream.json"
  P="$W/.claude/.upstream-prior/$TODAY"
  assert "prior capture dir" test -d "$P"
  assert "prior capture has the edited verify.md" grep -q "local edit" "$P/commands/verify.md"
  assert "prior capture has MANIFEST.md" test -f "$P/MANIFEST.md"
  assert "prior capture SHA256SUMS verifies" sh -c "cd '$P' && shasum -a 256 -c SHA256SUMS >/dev/null"
  assert "prior capture has docs" test -f "$P/docs/workflow-version.md"
  assert_grep "diff hint printed" "diff -r .claude/.upstream-prior/$TODAY/commands .claude/commands" "$S/out.log"
  assert "refreshed verify.md lost the local edit (the capture is where it lives now)" sh -c "! grep -q 'local edit' '$W/.claude/commands/verify.md'"
  mv "$W/.claude/commands/test-plan.md" "$S/"
  run "$W"
  assert_eq "still dev after manual removal" "$(manifest_roles "$W")" "dev"
  assert_eq "still exactly one capture" "$(ls "$W/.claude/.upstream-prior" | wc -l | tr -d ' ')" "1"
else
  bad "could not locate the 0.6.0 commit"
fi
# 0.7.0 = the newest commit on main whose version doc says 0.7.0 (baseline that still lists test-plan.md -> retired upstream, archived)
# prefer the release tag; else the newest commit that is 0.7.0-shaped (doc says 0.7.0, no roles/, test-plan.md still in core)
V7="$(git -C "$REPO" rev-parse -q --verify 'v0.7.0^{commit}' 2>/dev/null || true)"
if [ -z "$V7" ]; then
  for c in $(git -C "$REPO" log --format=%H main); do
    [ "$(git -C "$REPO" show "${c}:core/docs/workflow-version.md" 2>/dev/null | sed -n 's/^version: *//p')" = "0.7.0" ] || continue
    git -C "$REPO" cat-file -e "${c}:roles" 2>/dev/null && continue
    git -C "$REPO" cat-file -e "${c}:core/commands/test-plan.md" 2>/dev/null || continue
    V7="$c"; break
  done
fi
LEG7="$S/legacy-070"; mkdir -p "$LEG7"
if [ -n "$V7" ] && git -C "$REPO" archive "$V7" 2>/dev/null | tar -x -C "$LEG7" && grep -q write_upstream_baseline "$LEG7/install.sh"; then
  W="$(fresh c7b)"
  bash "$LEG7/install.sh" "$W" >/dev/null 2>&1
  assert "0.7.0 wrote a baseline" test -f "$W/.claude/.upstream-base/commands/test-plan.md"
  echo "<!-- local edit -->" >>"$W/.claude/commands/upstream.md"
  echo "<!-- local edit review -->" >>"$W/.claude/commands/verify.md"
  run "$W"
  assert_eq "exit" "$(rc)" 0
  assert_grep "roles inferred" "roles    dev (inferred from installed commands)" "$S/out.log"
  P="$W/.claude/.upstream-prior/$TODAY"
  assert "drifted core captured before the refresh" test -d "$P"
  assert "edited verify.md recoverable under installed/" grep -q "local edit review" "$P/installed/commands/verify.md"
  assert "edited upstream.md recoverable under installed/" grep -q "local edit" "$P/installed/commands/upstream.md"
  assert "old baseline copy of verify.md kept" cmp -s "$LEG7/core/commands/verify.md" "$P/baseline/commands/verify.md"
  assert "old baseline kept whole (test-plan.md too)" test -f "$P/baseline/commands/test-plan.md"
  assert "unedited files not duplicated under installed/" test ! -e "$P/installed/commands/clarify.md"
  assert_grep "MANIFEST names verify.md" 'commands/verify.md' "$P/MANIFEST.md"
  assert_grep "MANIFEST names upstream.md" 'commands/upstream.md' "$P/MANIFEST.md"
  assert_grep "MANIFEST records versions old -> new" "Versions: 0.7.0 -> $(sed -n 's/^version: *//p' "$REPO/core/docs/workflow-version.md" | head -1)" "$P/MANIFEST.md"
  assert "capture SHA256SUMS verifies" sh -c "cd '$P' && shasum -a 256 -c SHA256SUMS >/dev/null"
  assert_grep "notice names the drifted file" "commands/verify.md (modified)" "$S/out.log"
  assert_grep "notice counts both drifted files" "2 core file(s) differ from the 0.7.0 baseline" "$S/out.log"
  assert "live verify.md is the fresh copy" cmp -s "$REPO/roles/dev/commands/verify.md" "$W/.claude/commands/verify.md"
  assert "live verify.md lost the edit (it lives in the capture now)" sh -c "! grep -q 'local edit review' '$W/.claude/commands/verify.md'"
  assert "renamed pr.md archived as retired (baseline proves it was upstream's)" test -f "$W/.claude/_archived-commands/pr.md"
  assert "renamed pr.md gone from commands" test ! -e "$W/.claude/commands/pr.md"
  assert "retired test-plan.md archived" test -f "$W/.claude/_archived-commands/test-plan.md"
  assert "retired test-plan.md gone from commands" test ! -e "$W/.claude/commands/test-plan.md"
  assert_grep "retirement reported" "retired upstream" "$S/out.log"
  assert_eq "commands = core + dev" "$(installed_cmds "$W")" "$(expected_cmds dev)"
  assert "manifest from legacy baseline has roles" grep -q '"roles"' "$W/.claude/.upstream-manifest.json"
  cp "$LEG7/core/commands/test-plan.md" "$W/.claude/commands/test-plan.md"; echo "edited" >>"$W/.claude/commands/test-plan.md"
  cp "$LEG7/core/commands/test-plan.md" "$W/.claude/.upstream-base/commands/"
  run "$W"
  assert "locally modified retired file is kept" test -f "$W/.claude/commands/test-plan.md"
  assert_grep "kept + explained" "locally modified" "$S/out.log"
  assert "second drifted upgrade the same day gets a numeric suffix" test -d "$W/.claude/.upstream-prior/$TODAY.1"
  assert "suffixed capture holds the drifted test-plan.md" grep -q "^edited$" "$W/.claude/.upstream-prior/$TODAY.1/installed/commands/test-plan.md"
  assert "first capture untouched by the second" grep -q "local edit review" "$P/installed/commands/verify.md"
  # Same 0.7.0 install, no local edits: nothing can be lost, so nothing is captured.
  W="$(fresh c7c)"
  bash "$LEG7/install.sh" "$W" >/dev/null 2>&1
  run "$W"
  assert_eq "exit (clean upgrade)" "$(rc)" 0
  assert "clean 0.7.0 -> upgrade writes no .upstream-prior" test ! -e "$W/.claude/.upstream-prior"
  assert_grep "clean upgrade says so in one line" "core matches the baseline — nothing to capture" "$S/out.log"
  assert "clean upgrade still archives the retired command" test -f "$W/.claude/_archived-commands/test-plan.md"
else
  bad "main is not a 0.7.0-shaped checkout"
fi
end

# ---------------------------------------------------------------- 8. unknown role / bad flags
begin "8  unknown role and bad flags exit 1 with zero writes"
W="$(fresh c8)"; run "$W" --role qa
assert_eq "exit 1" "$(rc)" 1
assert_grep "lists available roles" "unknown role 'qa' (available: dev sdet" "$S/err.log"
assert_eq "zero writes" "$(find "$W" -mindepth 1 | wc -l | tr -d ' ')" "0"
run "$W" --bogus;             assert_eq "unknown flag exit 1" "$(rc)" 1; assert_grep "names the flag" "unknown flag --bogus" "$S/err.log"
run "$W" extra-arg;           assert_eq "extra positional exit 1" "$(rc)" 1
run "$W" --role;              assert_eq "missing value exit 1" "$(rc)" 1
run "$W" --role '../etc';     assert_eq "path-shaped role exit 1" "$(rc)" 1
run;                          assert_eq "no target exit 1" "$(rc)" 1
run "$S/does-not-exist";      assert_eq "missing target exit 1" "$(rc)" 1
assert_eq "still zero writes" "$(find "$W" -mindepth 1 | wc -l | tr -d ' ')" "0"
end

# ---------------------------------------------------------------- 9. collision fixture
begin "9  name collision across core + role exits 1 before any write"
D="$(copy_repo dup9)"; mkdir -p "$D/roles/sdet/commands"; cp "$D/core/commands/learn.md" "$D/roles/sdet/commands/learn.md"
W="$(fresh c9)"
"$D/install.sh" "$W" --role sdet >"$S/out.log" 2>"$S/err.log"; echo $? >"$S/rc"
assert_eq "exit 1" "$(rc)" 1
assert_grep "names the key" "commands/learn.md is provided by more than one source" "$S/err.log"
assert_grep "names core" "core" "$S/err.log"
assert_grep "names the role" "roles/sdet" "$S/err.log"
assert_eq "zero writes" "$(find "$W" -mindepth 1 | wc -l | tr -d ' ')" "0"
"$D/install.sh" "$W" --role dev >"$S/out.log" 2>"$S/err.log"; echo $? >"$S/rc"
assert_eq "unselected role's duplicate is not a collision" "$(rc)" 0
mkdir -p "$D/roles/dev/templates/repo"; cp "$D/templates/repo/pr-template.md" "$D/roles/dev/templates/repo/pr-template.md"
W2="$(fresh c9b)"
"$D/install.sh" "$W2" --role dev >"$S/out.log" 2>"$S/err.log"; echo $? >"$S/rc"
assert_eq "template collision exit 1" "$(rc)" 1
assert_grep "template key named" "templates/pr-template.md" "$S/err.log"
end

# ---------------------------------------------------------------- 10. drift with roles
begin "10 upstream.py drift sees role commands"
W="$(fresh c10)"; run "$W" --role dev
python3 "$REPO/core/scripts/upstream.py" --root "$W/.claude" drift >"$S/drift0.log" 2>&1
assert_grep "fresh install: no drift" "no local edits" "$S/drift0.log"
echo "" >>"$W/.claude/commands/clarify.md"; echo "<!-- project tweak -->" >>"$W/.claude/commands/clarify.md"
python3 "$REPO/core/scripts/upstream.py" --root "$W/.claude" drift >"$S/drift1.log" 2>&1
assert_grep "role command reported modified" "modified commands/clarify.md" "$S/drift1.log"
assert_eq "exactly one file drifted" "$(grep -c 'modified\|missing' "$S/drift1.log")" "1"
end

# ---------------------------------------------------------------- 11. hooks
begin "11 hook scripts executable; seeded hook has no inline path regex"
W="$(fresh c11)"; run "$W" --role dev
assert "guard-base-branch.sh executable" test -x "$W/.claude/scripts/guard-base-branch.sh"
assert "state-index-upsert.sh executable" test -x "$W/.claude/scripts/state-index-upsert.sh"
assert "settings.json is valid JSON" jq -e . "$W/.claude/settings.json"
assert "PostToolUse calls the upsert script" sh -c "jq -r '.hooks.PostToolUse[].hooks[].command' '$W/.claude/settings.json' | grep -q state-index-upsert.sh"
assert "no inline kind regex in the hook" sh -c "! jq -r '.hooks.PostToolUse[].hooks[].command' '$W/.claude/settings.json' | grep -q 'tickets|debug|builds'"
assert "upsert script still filters by its own regex" grep -q 'tickets|debug|builds|refactors|e2e' "$W/.claude/scripts/state-index-upsert.sh"
end

# ---------------------------------------------------------------- 12. pre-install capture once
begin "12 pre-install capture happens exactly once"
W="$(fresh c12)"; mkdir -p "$W/.claude/commands" "$W/.claude/hooks" "$W/.claude/agents"
echo "# custom" >"$W/.claude/commands/custom.md"; echo "# old verify" >"$W/.claude/commands/verify.md"
echo "echo hi" >"$W/.claude/hooks/pre.sh"; echo "# my agent" >"$W/.claude/agents/mine.md"
run "$W" --role dev
assert_eq "exit" "$(rc)" 0
P="$W/.claude/.upstream-prior/$TODAY"
assert "capture dir" test -d "$P"
assert "captured custom command" cmp -s "$P/commands/custom.md" "$W/.claude/commands/custom.md"
assert "captured old verify.md" grep -q "old verify" "$P/commands/verify.md"
assert "captured hooks/" test -f "$P/hooks/pre.sh"
assert "captured agents/" test -f "$P/agents/mine.md"
assert "MANIFEST.md" grep -q "Pre-install capture" "$P/MANIFEST.md"
assert "SHA256SUMS verifies" sh -c "cd '$P' && shasum -a 256 -c SHA256SUMS >/dev/null"
assert "project command left in place" test -f "$W/.claude/commands/custom.md"
assert "verify.md refreshed" sh -c "! grep -q 'old verify' '$W/.claude/commands/verify.md'"
assert_grep "capture reported" "captured .* files to .claude/.upstream-prior/$TODAY/" "$S/out.log"
echo "# another" >"$W/.claude/commands/another.md"
run "$W"
assert_eq "exactly one capture dir after re-run" "$(ls "$W/.claude/.upstream-prior" | wc -l | tr -d ' ')" "1"
assert "second run did not capture the new file" test ! -e "$P/commands/another.md"
assert_nogrep "no capture message on re-run" "captured" "$S/out.log"
end

# ---------------------------------------------------------------- 13. settings fragment merge
begin "13 role settings fragment merges on first seed, prints instructions afterwards"
D="$(copy_repo dup13)"; mkdir -p "$D/roles/sdet/templates/workspace"
cat >"$D/roles/sdet/templates/workspace/settings.sdet.fragment.json" <<'EOF'
{
  "permissions": { "allow": ["Bash(npx playwright:*)", "Bash(git diff:*)"] },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit", "hooks": [ { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/scripts/guard-test-integrity.sh", "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "echo done" } ] }
    ]
  }
}
EOF
W="$(fresh c13)"
"$D/install.sh" "$W" --role sdet >"$S/out.log" 2>"$S/err.log"; echo $? >"$S/rc"
assert_eq "exit" "$(rc)" 0
assert_grep "merge reported" "merged  roles/sdet/templates/workspace/settings.sdet.fragment.json -> settings.json" "$S/out.log"
SJ="$W/.claude/settings.json"
assert "valid JSON" jq -e . "$SJ"
assert_eq "PreToolUse concatenated (2 core + 1 fragment)" "$(jq '.hooks.PreToolUse | length' "$SJ")" "3"
assert_eq "PostToolUse kept" "$(jq '.hooks.PostToolUse | length' "$SJ")" "1"
assert_eq "new event added" "$(jq '.hooks.Stop | length' "$SJ")" "1"
assert_eq "allow unioned without duplicates" "$(jq '[.permissions.allow[] | select(. == "Bash(git diff:*)")] | length' "$SJ")" "1"
assert "allow gained the fragment entry" sh -c "jq -r '.permissions.allow[]' '$SJ' | grep -qx 'Bash(npx playwright:\*)'"
assert_eq "env kept from the core template" "$(jq -r '.env.WORKFLOW_LAYOUT' "$SJ")" "workspace"
assert "core guard hook still present" sh -c "jq -r '.hooks.PreToolUse[].hooks[].command' '$SJ' | grep -q guard-base-branch.sh"
"$D/install.sh" "$W" >"$S/out.log" 2>"$S/err.log"
assert_nogrep "already-wired fragment is silent on re-run" "NOT merged" "$S/out.log"
W2="$(fresh c13b)"
"$D/install.sh" "$W2" --role dev >/dev/null 2>&1
seed_sha "$W2" >"$S/before"
"$D/install.sh" "$W2" --roles dev,sdet >"$S/out.log" 2>"$S/err.log"
assert_grep "existing settings.json -> instruction, not a rewrite" "settings.sdet.fragment.json NOT merged (settings.json already existed)" "$S/out.log"
assert_grep "instruction paragraph" "copy each entry under \"hooks\"" "$S/out.log"
seed_sha "$W2" >"$S/after"; assert "settings.json untouched" diff "$S/before" "$S/after"
end

# ---------------------------------------------------------------- 14. --stack seed packs
begin "14 --stack appends a seed pack once; absent pack is a no-op"
W="$(fresh c14)"; run "$W" --role dev --stack nothing-here
assert_eq "exit with absent pack" "$(rc)" 0
assert_grep "absent pack reported" "no seed pack nothing-here" "$S/out.log"
D="$(copy_repo dup14)"; mkdir -p "$D/templates/seed-packs/webapp/nested"
printf '### [Pattern]: Co-locate feature code\nKeep a feature under one folder.\n_Source: seed-pack:webapp_\n' >"$D/templates/seed-packs/webapp/codebase-patterns.seed.md"
printf '### Mock at the boundary\n_Source: seed-pack:webapp_\n' >"$D/templates/seed-packs/webapp/testing-patterns.seed.md"
printf '### Missing target\n' >"$D/templates/seed-packs/webapp/no-such-file.seed.md"
printf '### Nested\n' >"$D/templates/seed-packs/webapp/nested/codebase-patterns.seed.md"
printf -- '- [ ] No console errors on the changed routes\n- [ ] Every interactive state checked' >"$D/templates/seed-packs/webapp/ticket-checklist.dod.md"  # no trailing newline on purpose
W="$(fresh c14b)"; mkdir -p "$W/.claude"
printf '%s' "$(cat "$REPO/templates/repo/testing-patterns.md")" >"$W/.claude/testing-patterns.md"  # pre-seeded WITHOUT a trailing newline: the pack must not glue to the last line
"$D/install.sh" "$W" --role dev --stack webapp >"$S/out.log" 2>"$S/err.log"; echo $? >"$S/rc"
assert_eq "exit" "$(rc)" 0
assert_eq "H2 appended once to codebase-patterns" "$(grep -c '^## Seed pack: webapp$' "$W/.claude/codebase-patterns.md")" "1"
assert_grep "body appended" "Co-locate feature code" "$W/.claude/codebase-patterns.md"
assert_eq "H2 appended once to testing-patterns" "$(grep -c '^## Seed pack: webapp$' "$W/.claude/testing-patterns.md")" "1"
assert_eq "marker line once in codebase-patterns" "$(grep -cE "^<!-- seed-pack: webapp $TODAY -->$" "$W/.claude/codebase-patterns.md")" "1"
assert_eq "marker line once in testing-patterns" "$(grep -cE "^<!-- seed-pack: webapp $TODAY -->$" "$W/.claude/testing-patterns.md")" "1"
assert_eq "marker is the line immediately before the H2" "$(grep -A1 "^<!-- seed-pack: webapp $TODAY -->$" "$W/.claude/codebase-patterns.md" | tail -1)" "## Seed pack: webapp"
assert_eq "marker on its own line even after an unterminated file" "$(grep -A1 "^<!-- seed-pack: webapp $TODAY -->$" "$W/.claude/testing-patterns.md" | tail -1)" "## Seed pack: webapp"
assert_grep "missing target skipped" "no-such-file.md is not present" "$S/out.log"
assert "missing target not created" test ! -e "$W/.claude/no-such-file.md"
assert_eq "DoD marker once" "$(grep -c '^<!-- seed-pack: webapp DoD -->$' "$W/.claude/ticket-checklist.md")" "1"
assert_eq "DoD lines landed once" "$(grep -c '^- \[ \] No console errors on the changed routes$' "$W/.claude/ticket-checklist.md")" "1"
assert_eq "DoD lines sit directly behind the marker at the end of the file" "$(tail -3 "$W/.claude/ticket-checklist.md")" "$(printf '<!-- seed-pack: webapp DoD -->\n- [ ] No console errors on the changed routes\n- [ ] Every interactive state checked')"
assert_grep "DoD append reported" "seed-pack webapp DoD -> ticket-checklist.md" "$S/out.log"
"$D/install.sh" "$W" --stack webapp >"$S/out.log" 2>"$S/err.log"
assert_eq "re-run does not duplicate" "$(grep -c '^## Seed pack: webapp$' "$W/.claude/codebase-patterns.md")" "1"
assert_grep "re-run reports already present" "already in codebase-patterns.md" "$S/out.log"
assert_eq "re-run keeps one marker" "$(grep -cE "^<!-- seed-pack: webapp $TODAY -->$" "$W/.claude/codebase-patterns.md")" "1"
assert_eq "re-run keeps one DoD marker" "$(grep -c '^<!-- seed-pack: webapp DoD -->$' "$W/.claude/ticket-checklist.md")" "1"
assert_eq "re-run keeps DoD lines exactly once" "$(grep -c '^- \[ \] Every interactive state checked$' "$W/.claude/ticket-checklist.md")" "1"
assert_grep "re-run reports DoD already present" "seed-pack webapp DoD already in ticket-checklist.md — already present" "$S/out.log"
"$D/install.sh" "$W" --stack webapp/nested >"$S/out.log" 2>"$S/err.log"
assert_eq "sub-pack gets its own H2" "$(grep -c '^## Seed pack: webapp/nested$' "$W/.claude/codebase-patterns.md")" "1"
assert_eq "sub-pack H2 comes after the flavor H2" "$(grep -n '^## Seed pack: webapp' "$W/.claude/codebase-patterns.md" | cut -d: -f2- | paste -sd'|' -)" "## Seed pack: webapp|## Seed pack: webapp/nested"
assert_eq "flavor pack not re-appended by the sub-pack run" "$(grep -c '^## Seed pack: webapp$' "$W/.claude/codebase-patterns.md")" "1"
# Real packs from the checkout: composition, sub-pack ordering, testing/playwright scope.
W="$(fresh c14c)"; run "$W" --role dev --stack fullstack-monorepo
assert_eq "exit (fullstack-monorepo)" "$(rc)" 0
assert_eq "fullstack-monorepo composes three H2s in order (codebase-patterns)" "$(grep '^## Seed pack: ' "$W/.claude/codebase-patterns.md" | paste -sd'|' -)" "## Seed pack: frontend-web|## Seed pack: backend-api|## Seed pack: fullstack-monorepo"
assert_eq "fullstack-monorepo composes three H2s in order (testing-patterns)" "$(grep '^## Seed pack: ' "$W/.claude/testing-patterns.md" | paste -sd'|' -)" "## Seed pack: frontend-web|## Seed pack: backend-api|## Seed pack: fullstack-monorepo"
assert_eq "fullstack-monorepo composes three DoD markers in order" "$(grep -o '^<!-- seed-pack: [a-z/-]* DoD -->$' "$W/.claude/ticket-checklist.md" | paste -sd'|' -)" "<!-- seed-pack: frontend-web DoD -->|<!-- seed-pack: backend-api DoD -->|<!-- seed-pack: fullstack-monorepo DoD -->"
assert_eq "three dated markers, one per H2" "$(grep -c "^<!-- seed-pack: [a-z/-]* $TODAY -->$" "$W/.claude/codebase-patterns.md")" "3"
assert_grep "frontend-web DoD line landed" "No console errors on the changed routes" "$W/.claude/ticket-checklist.md"
assert_grep "fullstack-monorepo DoD line landed" "Both the frontend-web and backend-api DoD items apply" "$W/.claude/ticket-checklist.md"
run "$W" --stack fullstack-monorepo
assert_eq "composed re-run is idempotent (H2s)" "$(grep -c '^## Seed pack: ' "$W/.claude/codebase-patterns.md")" "3"
assert_eq "composed re-run is idempotent (DoD)" "$(grep -c '^<!-- seed-pack: .* DoD -->$' "$W/.claude/ticket-checklist.md")" "3"
run "$W" --stack frontend-web/nextjs
assert_eq "sub-pack H2 present after its flavor pack" "$(grep -n '^## Seed pack: frontend-web' "$W/.claude/codebase-patterns.md" | cut -d: -f2- | paste -sd'|' -)" "## Seed pack: frontend-web|## Seed pack: frontend-web/nextjs"
assert_grep "sub-pack run leaves the flavor pack alone" "seed-pack frontend-web already in codebase-patterns.md" "$S/out.log"
W="$(fresh c14d)"; run "$W" --role dev --stack frontend-web/nextjs
assert_eq "sub-pack alone brings its flavor pack first" "$(grep '^## Seed pack: ' "$W/.claude/codebase-patterns.md" | paste -sd'|' -)" "## Seed pack: frontend-web|## Seed pack: frontend-web/nextjs"
W="$(fresh c14e)"; run "$W" --role dev
shasum -a 256 "$W/.claude/codebase-patterns.md" "$W/.claude/ticket-checklist.md" >"$S/before14"
run "$W" --stack testing/playwright
assert_eq "exit (testing/playwright)" "$(rc)" 0
assert_eq "testing/playwright lands in testing-patterns.md" "$(grep -c '^## Seed pack: testing/playwright$' "$W/.claude/testing-patterns.md")" "1"
assert "testing/playwright touched only testing-patterns.md" sh -c "shasum -a 256 -c '$S/before14' >/dev/null"
assert_nogrep "no 'testing' parent pack applied" "## Seed pack: testing$" "$W/.claude/testing-patterns.md"
assert "no stray pack output for the empty parent" sh -c "! grep -q 'no seed pack testing ' '$S/out.log'"
run "$W" --stack nothing-here --stack testing/playwright
assert_eq "absent pack next to a present one is a no-op" "$(grep -c '^## Seed pack: testing/playwright$' "$W/.claude/testing-patterns.md")" "1"
assert_grep "absent pack reported" "no seed pack nothing-here" "$S/out.log"
assert "absent pack wrote nothing" sh -c "shasum -a 256 -c '$S/before14' >/dev/null"
assert "pack files themselves untouched" sh -c "cd '$REPO' && git diff --quiet -- templates/seed-packs"
end

# ---------------------------------------------------------------- 15. drift capture on a 0.8.0 re-run
begin "15 re-run with edited core captures the drifted files + old baseline; clean re-run writes nothing"
W="$(fresh c15)"; run "$W" --role dev
run "$W"
assert "clean re-run: no .upstream-prior" test ! -e "$W/.claude/.upstream-prior"
echo "<!-- agent tweak -->" >>"$W/.claude/agents/codebase-investigator.md"
echo "<!-- doc tweak -->" >>"$W/.claude/workflow-version.md"
rm "$W/.claude/scripts/upstream.py"
echo "# mine" >"$W/.claude/commands/cover.md"   # project file at a path the sdet role is about to write
cp "$W/.claude/.upstream-manifest.json" "$S/manifest15"
run "$W" --roles dev,sdet
assert_eq "exit" "$(rc)" 0
P="$W/.claude/.upstream-prior/$TODAY"
assert "capture dir" test -d "$P"
assert "agents/ edit captured" grep -q "agent tweak" "$P/installed/agents/codebase-investigator.md"
assert "root doc edit captured under docs/" grep -q "doc tweak" "$P/installed/docs/workflow-version.md"
assert "deleted script has no installed copy but is listed" sh -c "test ! -e '$P/installed/scripts/upstream.py' && grep -q 'scripts/upstream.py.*missing' '$P/MANIFEST.md'"
assert "unbaselined file about to be overwritten captured" grep -q "^# mine$" "$P/installed/commands/cover.md"
assert_grep "MANIFEST flags it as unbaselined" "commands/cover.md.*unbaselined" "$P/MANIFEST.md"
assert_grep "MANIFEST counts four" "## Drifted files (4)" "$P/MANIFEST.md"
assert "old baseline copied whole (every core command present)" sh -c "for f in '$REPO'/core/commands/*.md; do test -f '$P/baseline/commands/'\$(basename \"\$f\") || exit 1; done"
assert "old baseline is the pre-run baseline (no sdet command in it)" test ! -e "$P/baseline/commands/cover.md"
assert "old baseline keeps the pre-edit agent" sh -c "! grep -q 'agent tweak' '$P/baseline/agents/codebase-investigator.md'"
assert "SHA256SUMS verifies" sh -c "cd '$P' && shasum -a 256 -c SHA256SUMS >/dev/null"
assert_grep "notice names each file" "agents/codebase-investigator.md (modified)" "$S/out.log"
assert_grep "notice names the missing script" "scripts/upstream.py (missing)" "$S/out.log"
assert "live agent refreshed" cmp -s "$REPO/core/agents/codebase-investigator.md" "$W/.claude/agents/codebase-investigator.md"
assert "live script restored" cmp -s "$REPO/core/scripts/upstream.py" "$W/.claude/scripts/upstream.py"
assert "live cover.md is still the project's (project-owned shadows the sdet copy)" grep -qx "# mine" "$W/.claude/commands/cover.md"
assert "sdet cover.md not mirrored into the baseline" test ! -e "$W/.claude/.upstream-base/commands/cover.md"
assert_grep "collision reported" "conflict commands/cover.md — project-owned" "$S/out.log"
assert_eq "manifest records the conflict" "$(jq -c .conflicts "$W/.claude/workflow-manifest.json")" '["commands/cover.md"]'
assert "drift clean again" sh -c "python3 '$REPO/core/scripts/upstream.py' --root '$W/.claude' drift | grep -q 'no local edits'"
run "$W"
assert_eq "clean re-run after the capture adds nothing" "$(ls "$W/.claude/.upstream-prior" | wc -l | tr -d ' ')" "1"
assert "re-run keeps the project's cover.md" grep -qx "# mine" "$W/.claude/commands/cover.md"
end

# ---------------------------------------------------------------- 16. project-owned files
begin "16 project-owned files are never overwritten or archived"
W="$(fresh c16)"; run "$W" --role dev
mkdir -p "$W/.claude/commands" "$W/.claude/agents" "$W/.claude/scripts"
printf '# intake\nProject-only step: triage the inbox before /ticket.\n' >"$W/.claude/commands/intake.md"
printf '# custom-agent\nProject-only agent.\n' >"$W/.claude/agents/custom-agent.md"
printf '#!/usr/bin/env bash\necho my-tool\n' >"$W/.claude/scripts/my-tool.sh"
owned_sha() { (cd "$1" && shasum -a 256 .claude/commands/intake.md .claude/agents/custom-agent.md .claude/scripts/my-tool.sh); }
owned_sha "$W" >"$S/owned-before"
run "$W"
assert_eq "exit" "$(rc)" 0
owned_sha "$W" >"$S/owned-after"; assert "re-run: project files byte-identical" diff "$S/owned-before" "$S/owned-after"
assert_grep "Done line counts the three" "project-owned left alone: 3" "$S/out.log"
assert_nogrep "no conflicts counted" "conflicts:" "$S/out.log"
assert_eq "manifest conflicts empty" "$(jq -c .conflicts "$W/.claude/workflow-manifest.json")" "[]"
assert_grep "local label names the command" "local    commands/intake.md" "$S/out.log"
assert_grep "local label names the agent" "local    agents/custom-agent.md" "$S/out.log"
assert_grep "local label names the script" "local    scripts/my-tool.sh" "$S/out.log"
assert "no capture: nothing of upstream's drifted" test ! -e "$W/.claude/.upstream-prior"
assert "project files never enter the baseline" test ! -e "$W/.claude/.upstream-base/commands/intake.md"
# A project command whose basename coincides with an UNSELECTED role's command is not that role's leftover.
echo "# mine, not sdet's" >"$W/.claude/commands/cover.md"
run "$W" --role dev
assert "role-switch pass leaves the look-alike alone" grep -q "mine, not sdet" "$W/.claude/commands/cover.md"
assert "look-alike not archived" test ! -e "$W/.claude/_archived-commands/cover.md"
assert_grep "look-alike listed as local" "local    commands/cover.md" "$S/out.log"
rm "$W/.claude/commands/cover.md"
run "$W" --role sdet
assert_eq "exit (switch to sdet)" "$(rc)" 0
run "$W" --role dev
assert_eq "exit (back to dev)" "$(rc)" 0
owned_sha "$W" >"$S/owned-after"; assert "role switch and back: project files byte-identical" diff "$S/owned-before" "$S/owned-after"
assert "intake.md not archived" test ! -e "$W/.claude/_archived-commands/intake.md"
assert "no archived copy of the agent or script" sh -c "! ls -R '$W/.claude/_archived-commands' | grep -q 'custom-agent.md\|my-tool.sh'"
for c in $DEV_ROLE_CMDS; do assert "retired-by-switch $c still archived (guard did not break the role pass)" test -f "$W/.claude/_archived-commands/$c"; done
assert_grep "after the switches the count is still 3" "project-owned left alone: 3" "$S/out.log"
# Upstream now ships a command with the SAME name, and retires one of its own.
D="$(copy_repo dup16)"
printf '# intake\nUPSTREAM intake — a different step entirely.\n' >"$D/roles/dev/commands/intake.md"
RETIRED="$(ls "$D"/core/commands/*.md | xargs -n1 basename | sort | head -1)"
rm "$D/core/commands/$RETIRED"
"$D/install.sh" "$W" >"$S/out.log" 2>"$S/err.log"; echo $? >"$S/rc"
assert_eq "exit (collision)" "$(rc)" 0
owned_sha "$W" >"$S/owned-after"; assert "collision: live intake.md is still the project's, byte-identical" diff "$S/owned-before" "$S/owned-after"
assert "live intake.md is not upstream's" sh -c "! grep -q 'UPSTREAM intake' '$W/.claude/commands/intake.md'"
assert_grep "conflict line printed" "conflict commands/intake.md — project-owned (never shipped upstream before); kept yours, upstream's new command of the same name was NOT installed. Rename yours to adopt upstream's." "$S/out.log"
assert_eq "manifest records the conflict" "$(jq -c .conflicts "$W/.claude/workflow-manifest.json")" '["commands/intake.md"]'
assert_eq "manifest keeps roles" "$(manifest_roles "$W")" "dev"
assert "upstream's intake.md not mirrored into the baseline" test ! -e "$W/.claude/.upstream-base/commands/intake.md"
P="$W/.claude/.upstream-prior/$TODAY"
assert "collision captured once under installed/" cmp -s "$W/.claude/commands/intake.md" "$P/installed/commands/intake.md"
assert_grep "capture flags it unbaselined" "commands/intake.md.*unbaselined" "$P/MANIFEST.md"
assert_grep "Done line: two left alone (intake.md is a conflict now)" "project-owned left alone: 2" "$S/out.log"
assert_grep "Done line counts the conflict" "conflicts: 1" "$S/out.log"
SDET_SCRIPT="$(ls "$REPO"/roles/sdet/scripts/* 2>/dev/null | xargs -n1 basename | sort | head -1)"
if [ -n "$SDET_SCRIPT" ]; then  # role scripts are not archived on a switch (hooks reference them): a leftover, not project-owned
  assert "unselected role's script still installed after the switch back" test -f "$W/.claude/scripts/$SDET_SCRIPT"
  assert_nogrep "unselected role's script is not called project-owned" "local    scripts/$SDET_SCRIPT" "$S/out.log"
  assert_grep "unselected role's script reported as a leftover" "leftover scripts/$SDET_SCRIPT — unmodified copy from role 'sdet'" "$S/out.log"
fi
assert "retired upstream command still archived (guard did not break retirement)" test -f "$W/.claude/_archived-commands/$RETIRED"
assert "retired command gone from commands/" test ! -e "$W/.claude/commands/$RETIRED"
assert_grep "retirement reported" "archived commands/$RETIRED" "$S/out.log"
"$D/install.sh" "$W" >"$S/out.log" 2>"$S/err.log"; echo $? >"$S/rc"
assert_eq "exit (collision re-run)" "$(rc)" 0
owned_sha "$W" >"$S/owned-after"; assert "re-run: still the project's bytes" diff "$S/owned-before" "$S/owned-after"
assert_grep "conflict reported again" "conflict commands/intake.md" "$S/out.log"
assert_eq "manifest still records it" "$(jq -c .conflicts "$W/.claude/workflow-manifest.json")" '["commands/intake.md"]'
assert "still not in the baseline" test ! -e "$W/.claude/.upstream-base/commands/intake.md"
assert_eq "no second capture dir" "$(ls "$W/.claude/.upstream-prior" | wc -l | tr -d ' ')" "1"
assert_grep "re-run reports a clean core" "core matches the baseline — nothing to capture" "$S/out.log"
# Adopting upstream's: rename yours -> upstream's copy installs, the conflict clears.
mv "$W/.claude/commands/intake.md" "$W/.claude/commands/intake-local.md"
"$D/install.sh" "$W" >"$S/out.log" 2>"$S/err.log"; echo $? >"$S/rc"
assert "after the rename upstream's intake.md is installed" grep -q "UPSTREAM intake" "$W/.claude/commands/intake.md"
assert "and mirrored into the baseline" cmp -s "$D/roles/dev/commands/intake.md" "$W/.claude/.upstream-base/commands/intake.md"
assert_eq "conflict cleared" "$(jq -c .conflicts "$W/.claude/workflow-manifest.json")" "[]"
assert_grep "renamed file is local" "local    commands/intake-local.md" "$S/out.log"
# No baseline at all: the rule cannot apply and the installer says so once.
W2="$(fresh c16b)"; mkdir -p "$W2/.claude/commands"; echo "# intake" >"$W2/.claude/commands/intake.md"
"$D/install.sh" "$W2" --role dev >"$S/out.log" 2>"$S/err.log"; echo $? >"$S/rc"
assert_eq "exit (no baseline)" "$(rc)" 0
assert_grep "no-baseline line printed" "prior    no baseline — project-owned files cannot be told apart" "$S/out.log"
assert "no baseline: today's capture-then-overwrite stands" grep -q "UPSTREAM intake" "$W2/.claude/commands/intake.md"
assert "captured before the overwrite" grep -qx "# intake" "$W2/.claude/.upstream-prior/$TODAY/commands/intake.md"
assert_eq "no conflicts recorded without a baseline" "$(jq -c .conflicts "$W2/.claude/workflow-manifest.json")" "[]"
end

echo ""
echo "install.sh suite: $pass passed, $fail failed"
[ "$fail" = 0 ]
